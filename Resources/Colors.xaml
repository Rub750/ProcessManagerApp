<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Colors -->
    <Color x:Key="LightBackground">#FFFFFF</Color>
    <Color x:Key="LightCardBackground">#F8F9FA</Color>
    <Color x:Key="LightSidebarBackground">#F0F2F5</Color>
    <Color x:Key="LightHeaderBackground">#FFFFFF</Color>
    <Color x:Key="LightText">#1E1E1E</Color>
    <Color x:Key="LightSecondaryText">#666666</Color>
    <Color x:Key="LightBorder">#E0E0E0</Color>
    <Color x:Key="LightHover">#E8F4FD</Color>
    <Color x:Key="LightPressed">#B3E5FC</Color>
    <Color x:Key="LightAccent">#2196F3</Color>
    <Color x:Key="LightAccentHover">#1976D2</Color>
    <Color x:Key="LightAccentPressed">#0D47A1</Color>
    <Color x:Key="LightWarning">#FF9800</Color>
    <Color x:Key="LightWarningHover">#F57C00</Color>
    <Color x:Key="LightWarningPressed">#E65100</Color>
    <Color x:Key="LightDanger">#F44336</Color>
    <Color x:Key="LightDangerHover">#D32F2F</Color>
    <Color x:Key="LightDangerPressed">#B71C1C</Color>
    <Color x:Key="LightNotification">#4CAF50</Color>
    <Color x:Key="LightNotificationText">#FFFFFF</Color>
    <Color x:Key="LightStatusBar">#F0F2F5</Color>
    <Color x:Key="LightStatusBarText">#666666</Color>
    <Color x:Key="LightInputBackground">#FFFFFF</Color>
    <Color x:Key="LightScrollBar">#E0E0E0</Color>
    <Color x:Key="LightScrollBarThumb">#B0BEC5</Color>
    <Color x:Key="LightProgressBackground">#E0E0E0</Color>

    <!-- Dark Theme Colors (Default) -->
    <Color x:Key="DarkBackground">#1E1E1E</Color>
    <Color x:Key="DarkCardBackground">#2D2D2D</Color>
    <Color x:Key="DarkSidebarBackground">#252525</Color>
    <Color x:Key="DarkHeaderBackground">#2D2D2D</Color>
    <Color x:Key="DarkText">#E0E0E0</Color>
    <Color x:Key="DarkSecondaryText">#9E9E9E</Color>
    <Color x:Key="DarkBorder">#424242</Color>
    <Color x:Key="DarkHover">#3A3A3A</Color>
    <Color x:Key="DarkPressed">#4A4A4A</Color>
    <Color x:Key="DarkAccent">#2196F3</Color>
    <Color x:Key="DarkAccentHover">#1976D2</Color>
    <Color x:Key="DarkAccentPressed">#0D47A1</Color>
    <Color x:Key="DarkWarning">#FF9800</Color>
    <Color x:Key="DarkWarningHover">#F57C00</Color>
    <Color x:Key="DarkWarningPressed">#E65100</Color>
    <Color x:Key="DarkDanger">#F44336</Color>
    <Color x:Key="DarkDangerHover">#D32F2F</Color>
    <Color x:Key="DarkDangerPressed">#B71C1C</Color>
    <Color x:Key="DarkNotification">#4CAF50</Color>
    <Color x:Key="DarkNotificationText">#FFFFFF</Color>
    <Color x:Key="DarkStatusBar">#252525</Color>
    <Color x:Key="DarkStatusBarText">#9E9E9E</Color>
    <Color x:Key="DarkInputBackground">#3D3D3D</Color>
    <Color x:Key="DarkScrollBar">#424242</Color>
    <Color x:Key="DarkScrollBarThumb">#616161</Color>
    <Color x:Key="DarkProgressBackground">#424242</Color>

    <!-- Brush Resources -->
    <!-- Dark Theme (Default) -->
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource DarkBackground}"/>
    <SolidColorBrush x:Key="CardBackground" Color="{StaticResource DarkCardBackground}"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="{StaticResource DarkSidebarBackground}"/>
    <SolidColorBrush x:Key="HeaderBackground" Color="{StaticResource DarkHeaderBackground}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource DarkText}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource DarkSecondaryText}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource DarkBorder}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource DarkHover}"/>
    <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource DarkPressed}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource DarkAccent}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource DarkAccentHover}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource DarkAccentPressed}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource DarkWarning}"/>
    <SolidColorBrush x:Key="WarningHoverBrush" Color="{StaticResource DarkWarningHover}"/>
    <SolidColorBrush x:Key="WarningPressedBrush" Color="{StaticResource DarkWarningPressed}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DarkDanger}"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DarkDangerHover}"/>
    <SolidColorBrush x:Key="DangerPressedBrush" Color="{StaticResource DarkDangerPressed}"/>
    <SolidColorBrush x:Key="NotificationBackground" Color="{StaticResource DarkNotification}"/>
    <SolidColorBrush x:Key="NotificationTextBrush" Color="{StaticResource DarkNotificationText}"/>
    <SolidColorBrush x:Key="StatusBarBackground" Color="{StaticResource DarkStatusBar}"/>
    <SolidColorBrush x:Key="StatusBarTextBrush" Color="{StaticResource DarkStatusBarText}"/>
    <SolidColorBrush x:Key="InputBackground" Color="{StaticResource DarkInputBackground}"/>
    <SolidColorBrush x:Key="ScrollBarBackground" Color="{StaticResource DarkScrollBar}"/>
    <SolidColorBrush x:Key="ScrollBarThumb" Color="{StaticResource DarkScrollBarThumb}"/>
    <SolidColorBrush x:Key="ProgressBackground" Color="{StaticResource DarkProgressBackground}"/>
    <SolidColorBrush x:Key="RowBackground" Color="{StaticResource DarkCardBackground}"/>
    <SolidColorBrush x:Key="AlternatingRowBackground" Color="{StaticResource DarkHover}"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="#616161"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#757575"/>
</ResourceDictionary>
