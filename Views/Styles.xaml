<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Global Colors -->
    <Color x:Key="PrimaryColor">#4A90E2</Color>
    <Color x:Key="SecondaryColor">#3A7BC8</Color>
    <Color x:Key="AccentColor">#FF6B6B</Color>
    <Color x:Key="SuccessColor">#50C878</Color>
    <Color x:Key="WarningColor">#FFA07A</Color>
    <Color x:Key="LightGray">#F5F5F5</Color>
    <Color x:Key="MediumGray">#DDDDDD</Color>
    <Color x:Key="DarkGray">#666666</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="LightGrayBrush" Color="{StaticResource LightGray}"/>
    <SolidColorBrush x:Key="MediumGrayBrush" Color="{StaticResource MediumGray}"/>
    <SolidColorBrush x:Key="DarkGrayBrush" Color="{StaticResource DarkGray}"/>

    <!-- Button Styles -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}"/>
        <Setter Property="Padding" Value="10,5,10,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="5"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#2A5AA8"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SuccessButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#3A9D5D"/>
        <Setter Property="Padding" Value="10,5,10,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="5"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#3A9D5D"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#2A7D45"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#E05A5A"/>
        <Setter Property="Padding" Value="10,5,10,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="5"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E05A5A"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#C04545"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- TextBox Styles -->
    <Style x:Key="SearchTextBox" TargetType="TextBox">
        <Setter Property="Padding" Value="8,5,8,5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource MediumGrayBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Width" Value="250"/>
    </Style>

    <!-- ComboBox Styles -->
    <Style x:Key="FilterComboBox" TargetType="ComboBox">
        <Setter Property="Padding" Value="5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource MediumGrayBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Width" Value="150"/>
    </Style>

    <!-- DataGrid Styles -->
    <Style x:Key="ProcessDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource LightGrayBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource MediumGrayBrush}"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
        <Setter Property="RowHeight" Value="30"/>
        <Setter Property="CanUserSortColumns" Value="True"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="SelectionMode" Value="Single"/>
    </Style>

    <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="10,5,10,5"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}"/>
    </Style>

    <!-- StatusBar Styles -->
    <Style x:Key="StatusBarStyle" TargetType="StatusBar">
        <Setter Property="Background" Value="{StaticResource LightGrayBrush}"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <Style x:Key="StatusBarItemStyle" TargetType="StatusBarItem">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource DarkGrayBrush}"/>
    </Style>

    <!-- Category Colors -->
    <SolidColorBrush x:Key="SystemCategoryBrush" Color="#FFE0E0"/>
    <SolidColorBrush x:Key="ApplicationCategoryBrush" Color="#E0FFE0"/>
    <SolidColorBrush x:Key="BackgroundCategoryBrush" Color="#E0E0FF"/>
    <SolidColorBrush x:Key="ServiceCategoryBrush" Color="#FFFFE0"/>
    <SolidColorBrush x:Key="UnknownCategoryBrush" Color="#F0F0F0"/>

    <!-- Priority Colors -->
    <SolidColorBrush x:Key="IdlePriorityBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="BelowNormalPriorityBrush" Color="#E0E0FF"/>
    <SolidColorBrush x:Key="NormalPriorityBrush" Color="#E0FFE0"/>
    <SolidColorBrush x:Key="AboveNormalPriorityBrush" Color="#FFFFE0"/>
    <SolidColorBrush x:Key="HighPriorityBrush" Color="#FFE0E0"/>
    <SolidColorBrush x:Key="RealtimePriorityBrush" Color="#FFD0D0"/>

</ResourceDictionary>
